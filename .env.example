# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. NEVER commit real credentials.

# ---------------------------------------------------------------------------
# DATABASE_URL  (REQUIRED — Postgres via Supabase. There is no SQLite fallback.)
# ---------------------------------------------------------------------------
# Get this from: Supabase Dashboard -> Project -> Connect -> Connection String
# Choose "URI" and switch the driver dropdown to "Session pooler" (port 5432).
#
#   postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# !! URL-encode your password:  @ -> %40   : -> %3A   / -> %2F   # -> %23
# !! A wrong password is the #1 cause of "password authentication failed".
#
# Force TLS (Supabase requires it):
#   ...:5432/postgres?sslmode=require
#
# ALTERNATIVE — Transaction pooler (port 6543) for high concurrency:
#   postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&prepare_threshold=0
#   ^ prepare_threshold=0 disables psycopg prepared statements, which PgBouncer
#     (transaction mode) does not support. Session pooler (5432) needs no such flag.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase client SDK creds — only needed for Auth / Storage / Realtime.
# NOT used for database access; that goes through DATABASE_URL above.
# Dashboard -> Project -> API Keys
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
# Service-role key bypasses Row Level Security. Server-only: never ship to a client.
SUPABASE_SERVICE_ROLE_KEY=